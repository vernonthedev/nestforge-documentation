    <script is:inline>
      (() => {
        const key = 'nestforge-home-theme';
        const root = document.documentElement;
        const switchEl = document.getElementById('home-theme-switch');
        const media = window.matchMedia('(prefers-color-scheme: light)');

        const setTheme = (theme) => {
          root.dataset.theme = theme;
          if (switchEl) {
            switchEl.setAttribute('aria-checked', String(theme === 'light'));
            switchEl.dataset.theme = theme;
          }
        };

        const getStoredTheme = () => {
          const stored = localStorage.getItem(key);
          if (stored === 'light' || stored === 'dark') return stored;
          return null;
        };

        const getSystemTheme = () => (media.matches ? 'light' : 'dark');

        setTheme(getStoredTheme() ?? getSystemTheme());

        switchEl?.addEventListener('click', () => {
          const next = root.dataset.theme === 'light' ? 'dark' : 'light';
          localStorage.setItem(key, next);
          setTheme(next);
        });

        media.addEventListener('change', () => {
          if (!getStoredTheme()) setTheme(getSystemTheme());
        });

        const select = document.getElementById('install-select');
        const text = document.getElementById('install-text');
        select?.addEventListener('change', () => {
          if (text) text.textContent = select.value;
        });
        document.querySelectorAll('#install-copy').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const line = btn.closest('.hero-command');
            const code = line?.querySelector('code')?.textContent ?? '';
            try {
              await navigator.clipboard.writeText(code);
            } catch {}
          });
        });
        const closingCopy = document.getElementById('install-copy-closing');
        closingCopy?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText('cargo install nestforge-cli');
          } catch {}
        });
      })();
    </script>
